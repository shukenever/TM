{
  "framework": null,
  "buildCommand": "npm run build:securetixx",
  "outputDirectory": "public",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/ticket-reminders/cron",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/shop/cron-sync",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/shop/cron-home",
      "schedule": "0 14 * * *"
    }
  ],
  "functions": {
    "api/shop/[...slug].js": {
      "maxDuration": 60
    },
    "api/tm-pkpass.js": {
      "includeFiles": "wallet-pass-assets/**"
    },
    "api/tm-email-gate-static.js": {
      "includeFiles": "tm-email-gate.js"
    }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/my-tickets.html", "destination": "/my-tickets", "permanent": true },
    { "source": "/shop.html", "destination": "/shop", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/tm-email-gate.js",
      "destination": "/api/tm-email-gate-static"
    },
    {
      "source": "/api/v1/mail",
      "destination": "/api/send-mail"
    },
    {
      "source": "/tm_viewer_mail_api_base.js",
      "destination": "/api/tm-viewer/tm-viewer-mail-api-base"
    },
    {
      "source": "/tickets/:gid/:slug",
      "destination": "/api/tm-passes-fetch?gid=:gid&slug=:slug"
    },
    {
      "source": "/api/tm-viewer/send-mail",
      "destination": "/api/send-mail"
    },
    {
      "source": "/api/tm-viewer/transfer-to-buyer",
      "destination": "/api/send-mail"
    }
  ]
}
