# US proxy (required — do not run from non-US IP)
STAGEFRONT_PROXY=host:port:user:pass

# Auth: full Cookie header from browser (required when 2FA is enabled)
STAGEFRONT_COOKIE=
# STAGEFRONT_USER=
# STAGEFRONT_PASSWORD=

# Optional: sharing rule "shu" is usually id 3612
STAGEFRONT_SHARING_RULE_ID=3612
